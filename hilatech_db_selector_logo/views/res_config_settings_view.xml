<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_settings_db_selector_logo" model="ir.ui.view">
        <field name="name">res.config.settings.db.selector.logo</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='user_default_rights']" position="before">
                <block title="Database Selector" id="hl_db_selector_block">
                    <setting string="Database Selector Logo" help="Logo shown on the database selection page, before logging in. Stored on the server and shared by all databases. Empty = Odoo logo.">
                        <field name="hl_db_selector_logo" widget="image" options="{'size': [200, 80]}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
