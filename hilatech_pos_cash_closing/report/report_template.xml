<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_cloture_caisse_template">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.external_layout">
                <div class="page" style="padding:20px; margin:0;">

                    <!-- En-tête dans un tableau -->
                    <table style="width:100%; border-collapse:collapse; margin-bottom:20px; border:2px solid #366092;">
                        <tr style="background-color:#366092; color:white;">
                            <td style="padding:12px 16px; text-align:center;">
                                <h2 style="margin:0; font-size:18px; font-weight:bold; color:#FFFFFF;">RAPPORT DE CLÔTURE DE CAISSE</h2>
                                <h3 style="margin:4px 0 0 0; font-size:14px; font-weight:normal; color:#FFFFFF;">
                                    <t t-out="doc.pos_config_id.name"/>
                                </h3>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:12px 16px;">
                                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                                    <tr>
                                        <td style="width:33%; padding:6px 0; text-align:left;">
                                            <strong>Date :</strong> <t t-out="doc.date.strftime('%d/%m/%Y')"/>
                                        </td>
                                        <td style="width:33%; padding:6px 0; text-align:left;">
                                            <strong>Référence :</strong> <t t-out="doc.name"/>
                                        </td>
                                        <td style="width:33%; padding:6px 0; text-align:left;">
                                            <strong>Session :</strong> <t t-out="doc.session_id.name or '—'"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:33%; padding:6px 0; text-align:left;">
                                            <strong>Ouverture :</strong>
                                            <t t-if="doc.session_id and doc.session_id.start_at">
                                                <t t-out="doc.session_id.start_at.strftime('%H:%M')"/>
                                            </t>
                                            <t t-else="">—</t>
                                        </td>
                                        <td style="width:33%; padding:6px 0; text-align:left;">
                                            <strong>Fermeture :</strong>
                                            <t t-if="doc.session_id and doc.session_id.stop_at">
                                                <t t-out="doc.session_id.stop_at.strftime('%H:%M')"/>
                                            </t>
                                            <t t-else="">—</t>
                                        </td>
                                        <td style="width:33%; padding:6px 0; text-align:left;">
                                            <strong>Statut :</strong>
                                            <t t-if="doc.state == 'draft'">Brouillon</t>
                                            <t t-elif="doc.state == 'confirmed'">Confirmé</t>
                                            <t t-else="">Approuvé</t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:33%; padding:6px 0; text-align:left;">
                                            <strong>Caissier :</strong> <t t-out="doc.caissier_id.name or '—'"/>
                                        </td>
                                        <td style="width:33%; padding:6px 0; text-align:left;">
                                            <strong>Numéro Session :</strong> <t t-out="doc.session_id.id if doc.session_id else '—'"/>
                                        </td>
                                        <td style="width:33%; padding:6px 0; text-align:left;">
                                            <strong>Clôturée par :</strong> <t t-out="doc.manager_id.name"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- Tableau principal -->
                    <table style="width:100%; border-collapse:collapse; font-size:11px;">
                        <thead>
                            <tr style="background-color:#2c3e50; color:white;">
                                <th style="border:1px solid #ccc; padding:6px 8px; text-align:left;">
                                    Mode de Paiement
                                </th>
                                <th style="border:1px solid #ccc; padding:6px 8px; text-align:right;">
                                    Contrôle Physique
                                </th>
                                <th style="border:1px solid #ccc; padding:6px 8px; text-align:right;">
                                    Etat ERP
                                </th>
                                <th style="border:1px solid #ccc; padding:6px 8px; text-align:right;">
                                    Balance (Excédent ou Manquant)
                                </th>
                                <th style="border:1px solid #ccc; padding:6px 8px; text-align:right;">
                                    Commission Paiement
                                </th>
                                <th style="border:1px solid #ccc; padding:6px 8px; text-align:right;">
                                    Ecart ou Manquant
                                </th>
                                <th style="border:1px solid #ccc; padding:6px 8px; text-align:center;">
                                    Statut
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.line_ids" t-as="line">
                                <!-- Couleur de fond selon l'écart -->
                                <t t-set="row_style" t-value="'background-color:#ffeaea;' if line.ecart &lt; 0 else ('background-color:#eafaf1;' if line.ecart &gt; 0 else '')"/>
                                <tr t-att-style="row_style">
                                    <td style="border:1px solid #ccc; padding:5px 8px; font-weight:bold;">
                                        <t t-out="line.label"/>
                                    </td>
                                    <td style="border:1px solid #ccc; padding:5px 8px; text-align:right;">
                                        <t t-if="not line.is_remboursement">
                                            <t t-out="'{:,.2f}'.format(line.controle_physique)"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                    <td style="border:1px solid #ccc; padding:5px 8px; text-align:right;">
                                        <t t-out="'{:,.2f}'.format(line.etat_erp)"/>
                                    </td>
                                    <td t-att-style="'border:1px solid #ccc; padding:5px 8px; text-align:right;' + row_style + ('color:red;' if line.balance &lt; 0 else ('color:green;' if line.balance &gt; 0 else 'color:#888;'))">
                                        <t t-if="line.balance != 0">
                                            <t t-out="'{:,.2f}'.format(line.balance)"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                    <td style="border:1px solid #ccc; padding:5px 8px; text-align:right;">
                                        <t t-if="line.commission != 0">
                                            <t t-out="'{:,.2f}'.format(line.commission)"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                    <td t-att-style="'border:1px solid #ccc; padding:5px 8px; text-align:right; font-weight:bold;' + row_style + ('color:red;' if line.ecart &lt; 0 else ('color:green;' if line.ecart &gt; 0 else 'color:#888;'))">
                                        <t t-if="line.ecart != 0">
                                            <t t-out="'{:,.2f}'.format(line.ecart)"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                    <td style="border:1px solid #ccc; padding:5px 8px; text-align:center; font-size:10px;">
                                        <t t-if="line.remboursement_state == 'a_rembourser'">
                                            <span style="color:red; font-weight:bold;">À Rembourser</span>
                                        </t>
                                        <t t-elif="line.remboursement_state == 'non_remboursable'">
                                            <span style="color:#888;">Non Remboursable</span>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>

                        <!-- Ligne TOTAUX -->
                        <tfoot>
                            <tr style="background-color:#2c3e50; color:white; font-weight:bold;">
                                <td style="border:1px solid #aaa; padding:6px 8px;">TOTAUX</td>
                                <td style="border:1px solid #aaa; padding:6px 8px; text-align:right;">
                                    <t t-out="'{:,.2f}'.format(doc.total_physique)"/>
                                </td>
                                <td style="border:1px solid #aaa; padding:6px 8px; text-align:right;">
                                    <t t-out="'{:,.2f}'.format(doc.total_erp)"/>
                                </td>
                                <td style="border:1px solid #aaa; padding:6px 8px; text-align:right;">
                                    <t t-out="'{:,.2f}'.format(doc.total_balance)"/>
                                </td>
                                <td style="border:1px solid #aaa; padding:6px 8px; text-align:right;">
                                    <t t-out="'{:,.2f}'.format(doc.total_commission)"/>
                                </td>
                                <td style="border:1px solid #aaa; padding:6px 8px; text-align:right;">
                                    <t t-out="'{:,.2f}'.format(doc.manquant_finale)"/>
                                </td>
                                <td style="border:1px solid #aaa; padding:6px 8px;"></td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- Résumé Manquant Final -->
                    <div style="margin-top:16px; text-align:right;">
                        <table style="margin-left:auto; border-collapse:collapse; min-width:300px;">
                            <tr>
                                <td style="padding:6px 12px; font-size:13px; font-weight:bold;">
                                    <t t-if="doc.manquant_finale == 0">
                                        Résultat Final :
                                    </t>
                                    <t t-elif="doc.manquant_finale &lt; 0">
                                        Manquant Final :
                                    </t>
                                    <t t-else="">
                                        Excédent Final :
                                    </t>
                                </td>
                                <td style="padding:6px 12px; font-size:16px; font-weight:bold; text-align:right;">
                                    <t t-if="doc.manquant_finale == 0">
                                        <span style="background-color:#198754; color:white; padding:4px 12px; border-radius:4px;">
                                            Bravo !
                                        </span>
                                    </t>
                                    <t t-elif="doc.manquant_finale &lt; 0">
                                        <span style="color:red;">
                                            <t t-out="'{:,.2f}'.format(doc.manquant_finale)"/>
                                        </span>
                                    </t>
                                    <t t-else="">
                                        <span style="color:green;">
                                            <t t-out="'{:,.2f}'.format(doc.manquant_finale)"/>
                                        </span>
                                    </t>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Décision (si manquant) et Observations -->
                    <t t-if="doc.note or (doc.manquant_finale &lt; 0)">
                        <div style="margin-top:16px; border-top:1px solid #ccc; padding-top:10px;">
                            <t t-if="doc.manquant_finale &lt; 0 and doc.decision">
                                <div style="margin-bottom:10px;">
                                    <strong>Décision Finale :</strong>
                                    <p style="margin:4px 0; font-size:13px;">
                                        <t t-if="doc.decision == 'a_rembourser'">
                                            <span style="color:red; font-weight:bold;">À Rembourser</span>
                                        </t>
                                        <t t-else="">
                                            <span style="color:#555; font-weight:bold;">Non Remboursable</span>
                                        </t>
                                    </p>
                                </div>
                            </t>
                            <t t-if="doc.note">
                                <strong>Observations :</strong>
                                <p style="margin-top:4px; white-space:pre-wrap;"><t t-out="doc.note"/></p>
                            </t>
                        </div>
                    </t>

                    <!-- Signatures -->
                    <div style="margin-top:40px; display:flex; justify-content:space-between;">
                        <div style="text-align:center; width:40%;">
                            <div style="border-top:1px solid #333; padding-top:6px; margin-top:40px;">
                                Manager : <strong><t t-out="doc.manager_id.name"/></strong>
                            </div>
                        </div>
                        <div style="text-align:center; width:40%;">
                            <div style="border-top:1px solid #333; padding-top:6px; margin-top:40px;">
                                Caissier du jour : <strong><t t-out="doc.caissier_id.name or '—'"/></strong>
                            </div>
                        </div>
                    </div>

                </div>
            </t>
        </t>
    </t>
</template>
</odoo>
