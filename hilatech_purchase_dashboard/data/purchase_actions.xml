<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Filtered actions for dashboard scorecard drill-down -->

    <!-- Bons de commande confirmés (Total achats + Bons de commande scorecards) -->
    <record id="action_dashboard_po_confirmed" model="ir.actions.act_window">
        <field name="name">Bons de commande confirmés</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['purchase', 'done'])]</field>
    </record>
    <menuitem id="menu_dashboard_po_confirmed"
        name="BC confirmés"
        parent="purchase.menu_procurement_management"
        action="action_dashboard_po_confirmed"
        sequence="50"/>

    <!-- BC non reçus -->
    <record id="action_dashboard_po_not_received" model="ir.actions.act_window">
        <field name="name">BC non reçus</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'purchase'), ('receipt_status', 'in', ['nothing', 'partial'])]</field>
    </record>
    <menuitem id="menu_dashboard_po_not_received"
        name="BC non reçus"
        parent="purchase.menu_procurement_management"
        action="action_dashboard_po_not_received"
        sequence="51"/>

    <!-- BC non facturés -->
    <record id="action_dashboard_po_not_invoiced" model="ir.actions.act_window">
        <field name="name">BC non facturés</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['purchase', 'done']), ('invoice_status', 'in', ['nothing', 'to invoice'])]</field>
    </record>
    <menuitem id="menu_dashboard_po_not_invoiced"
        name="BC non facturés"
        parent="purchase.menu_procurement_management"
        action="action_dashboard_po_not_invoiced"
        sequence="52"/>

    <!-- Dette fournisseurs (factures impayées) -->
    <record id="action_dashboard_vendor_debt" model="ir.actions.act_window">
        <field name="name">Dette fournisseurs</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'in_invoice'), ('state', '=', 'posted'), ('payment_state', 'in', ['not_paid', 'partial'])]</field>
    </record>
    <menuitem id="menu_dashboard_vendor_debt"
        name="Factures impayées"
        parent="account.menu_finance_payables"
        action="action_dashboard_vendor_debt"
        sequence="50"/>
</odoo>
