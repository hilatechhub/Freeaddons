<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Rapport PDF QWeb (référence interne, appelé via server action) -->
    <record id="action_report_stock_inventory_pdf" model="ir.actions.report">
        <field name="name">Rapport de Stock</field>
        <field name="model">stock.inventory.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hilatech_stock_report_by_warehouse.report_stock_inventory</field>
        <field name="report_file">hilatech_stock_report_by_warehouse.report_stock_inventory</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- Action serveur : Imprimer PDF (tout ou sélection) -->
    <record id="action_print_stock_inventory_pdf" model="ir.actions.server">
        <field name="name">Imprimer PDF</field>
        <field name="model_id" ref="model_stock_inventory_report"/>
        <field name="binding_model_id" ref="model_stock_inventory_report"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = env.ref('hilatech_stock_report_by_warehouse.action_report_stock_inventory_pdf').report_action(records.sudo())
else:
    all_recs = env['stock.inventory.report'].sudo().search([])
    action = env.ref('hilatech_stock_report_by_warehouse.action_report_stock_inventory_pdf').report_action(all_recs)
        </field>
    </record>

    <!-- Action serveur : Exporter Excel (tout ou sélection) -->
    <record id="action_export_stock_inventory_xlsx" model="ir.actions.server">
        <field name="name">Exporter Excel</field>
        <field name="model_id" ref="model_stock_inventory_report"/>
        <field name="binding_model_id" ref="model_stock_inventory_report"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.sudo().action_export_xlsx()
else:
    action = env['stock.inventory.report'].sudo().search([]).action_export_xlsx()
        </field>
    </record>

</odoo>
