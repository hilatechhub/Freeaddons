<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rapport PDF Caisse direct depuis relevé mensuel -->
    <record id="report_cash_journal_pdf" model="ir.actions.report">
        <field name="name">Rapport de Caisse</field>
        <field name="model">cash.journal.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hilatech_cash_journal.report_cash_journal_pdf_template</field>
        <field name="print_report_name">'Rapport Caisse - %s' % (object.month_date.strftime('%d_%m_%Y'))</field>
        <field name="binding_model_id" ref="model_cash_journal_report"/>
    </record>

    <!-- Template du Rapport avec Layout Standard -->
    <template id="report_cash_journal_pdf_template">
        <style>
            .page::after { content: '' !important; }
            div.footer { display: none !important; }
        </style>
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="report">
                    <t t-set="company" t-value="report.company_id"/>
                    <t t-set="primary_color" t-value="company.primary_color or '#1f4788'"/>
                    <t t-set="secondary_color" t-value="company.secondary_color or '#f5f5f5'"/>

                    <div class="page">
                        <div style="margin-left: 15mm; margin-right: 15mm; margin-top: 50mm; margin-bottom: 10mm;">
                        <!-- En-tête principal -->
                        <div style="text-align: center; margin-bottom: 30px;">
                            <h1 style="color: " t-att-style="'color: ' + primary_color + '; font-size: 28px; margin: 0;'">RELEVÉ DE CAISSE</h1>
                            <h2 style="color: #666; font-size: 14px; margin: 10px 0 0 0;">
                                <t t-esc="report.company_id.name"/>
                            </h2>
                            <p style="font-size: 12px; color: #666; margin: 8px 0;">
                                Mois: <t t-esc="report.month_date.strftime('%B %Y')"/>
                            </p>
                            <p style="font-size: 11px; color: #999;">
                                Généré le: <t t-esc="report.create_date.strftime('%d/%m/%Y %H:%M:%S') if report.create_date else ''"/>
                            </p>
                        </div>

                        <!-- Infos du Relevé -->
                        <div style="margin-bottom: 25px;">
                            <table class="table table-sm" style="margin-bottom: 15px; border-collapse: collapse; width: 100%;">
                                <tbody>
                                    <tr style="background-color: #f9f9f9;">
                                        <td style="border: 1px solid #ddd; padding: 10px; width: 25%;"><strong>Solde Initial</strong></td>
                                        <td style="border: 1px solid #ddd; padding: 10px; width: 25%; text-align: right;">
                                            <t t-esc="'{:,.2f}'.format(report.initial_balance)"/>
                                        </td>
                                        <td style="border: 1px solid #ddd; padding: 10px; width: 25%;"><strong>Total Opérations</strong></td>
                                        <td style="border: 1px solid #ddd; padding: 10px; width: 25%; text-align: right;">
                                            <t t-esc="'{:,.2f}'.format(sum(report.operation_ids.mapped('amount')))"/>
                                        </td>
                                    </tr>
                                    <tr style="background-color: #f9f9f9;">
                                        <td style="border: 1px solid #ddd; padding: 10px;"><strong>Solde Final</strong></td>
                                        <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">
                                            <t t-esc="'{:,.2f}'.format(report.final_balance)"/>
                                        </td>
                                        <td style="border: 1px solid #ddd; padding: 10px;"><strong>Responsable</strong></td>
                                        <td style="border: 1px solid #ddd; padding: 10px;">
                                            <t t-esc="report.user_id.name"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Opérations détaillées -->
                            <t t-if="report.operation_ids">
                                <table class="table table-sm table-striped" style="border-collapse: collapse; width: 100%; margin-bottom: 20px;">
                                    <thead>
                                        <tr style="background-color: #1f4788; color: white;">
                                            <th style="border: 1px solid #ddd; padding: 10px; text-align: left;">Date</th>
                                            <th style="border: 1px solid #ddd; padding: 10px; text-align: left;">Description</th>
                                            <th style="border: 1px solid #ddd; padding: 10px; text-align: left;">Reçu par</th>
                                            <th style="border: 1px solid #ddd; padding: 10px; text-align: center;">Type</th>
                                            <th style="border: 1px solid #ddd; padding: 10px; text-align: right;">Montant</th>
                                            <th style="border: 1px solid #ddd; padding: 10px; text-align: center;">Verrouillé</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="report.operation_ids" t-as="op">
                                            <tr style="background-color: #ffffff;">
                                                <td style="border: 1px solid #ddd; padding: 8px;">
                                                    <t t-esc="op.date.strftime('%d/%m/%Y')"/>
                                                </td>
                                                <td style="border: 1px solid #ddd; padding: 8px;">
                                                    <t t-esc="op.description"/>
                                                </td>
                                                <td style="border: 1px solid #ddd; padding: 8px;">
                                                    <t t-esc="op.received_by.name"/>
                                                </td>
                                                <td style="border: 1px solid #ddd; padding: 8px; text-align: center;">
                                                    <t t-if="op.amount > 0">Entrée</t>
                                                    <t t-if="op.amount &lt; 0">Sortie</t>
                                                    <t t-if="op.amount == 0">Neutre</t>
                                                </td>
                                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">
                                                    <t t-esc="'{:,.2f}'.format(op.amount)"/>
                                                </td>
                                                <td style="border: 1px solid #ddd; padding: 8px; text-align: center;">
                                                    <t t-if="op.is_locked">Oui</t>
                                                    <t t-if="not op.is_locked">Non</t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                        </div>
                        </div>
                    </div>

                    <t t-if="not report == docs[-1]">
                        <div style="page-break-after: always;"></div>
                    </t>
                </t>
            </t>
        </t>
    </template>
</odoo>
